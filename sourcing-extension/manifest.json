{
  "manifest_version": 3,
  "name": "TechTools Sourcing Importer",
  "version": "1.0.0",
  "description": "Import a product from Alibaba or Amazon into TechTools' Sourcing review queue with one click.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.alibaba.com/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.it/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.es/*",
    "https://techtoolstore.com/*",
    "http://localhost:9000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.alibaba.com/product-detail/*"],
      "js": ["content-scripts/inject-button.js", "content-scripts/alibaba.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*/dp/*",
        "https://www.amazon.com/dp/*",
        "https://www.amazon.co.uk/*/dp/*",
        "https://www.amazon.co.uk/dp/*",
        "https://www.amazon.de/*/dp/*",
        "https://www.amazon.de/dp/*",
        "https://www.amazon.it/*/dp/*",
        "https://www.amazon.it/dp/*",
        "https://www.amazon.fr/*/dp/*",
        "https://www.amazon.fr/dp/*",
        "https://www.amazon.es/*/dp/*",
        "https://www.amazon.es/dp/*"
      ],
      "js": ["content-scripts/inject-button.js", "content-scripts/amazon.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TechTools Sourcing"
  },
  "options_page": "options/options.html"
}
