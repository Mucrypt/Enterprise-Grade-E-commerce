{
  "name": "e-commerce-web-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "build:analyze": "ANALYZE_BUNDLE=true tsc -b && vite build",
    "perf:budget": "node scripts/check-bundle-budgets.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "docker:dev": "docker compose -f ../infrastructure/docker-compose.dev.yml up web-store -d --build",
    "docker:dev:logs": "docker compose -f ../infrastructure/docker-compose.dev.yml logs -f web-store",
    "docker:dev:stop": "docker compose -f ../infrastructure/docker-compose.dev.yml stop web-store",
    "docker:dev:restart": "npm run docker:dev:stop && npm run docker:dev",
    "docker:prod": "docker compose -f ../infrastructure/docker-compose.prod.yml up web-store -d --build",
    "docker:prod:logs": "docker compose -f ../infrastructure/docker-compose.prod.yml logs -f web-store",
    "docker:exec": "docker exec -it techtools-web-store-dev sh"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^3.5.0",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.14",
    "i18next": "^26.3.6",
    "lucide-react": "^0.576.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
