# TechTools Enterprise - Root Environment Variables
# Copy this to .env and fill in your values

# Database
DB_NAME=techtools
DB_USER=techtools_user
DB_PASSWORD=ChangeMe123!

# Redis
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API Port
PORT=9000

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3001,http://localhost:5173,http://localhost:8080

# Email (Production Only)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Stripe (Production Only)
# docker-compose.prod.yml already passes these through to the api
# container's environment (infrastructure/docker-compose.prod.yml) -- this
# file just didn't document them, so an operator copying this to .env had
# no way to know they were needed. Without STRIPE_WEBHOOK_SECRET, every
# webhook Stripe sends (payment confirmation, refunds) gets rejected with
# 500 "Webhook not configured". Get it from the Stripe Dashboard ->
# Developers -> Webhooks -> your production endpoint
# (https://yourdomain.com/api/v1/payments/webhook).
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# AWS (Production Only, legacy -- unused unless you add a custom S3 provider)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Media storage -- choose one provider. 'local' (default) needs nothing
# else below; Cloudflare R2 and Cloudinary are alternatives.
MEDIA_STORAGE_PROVIDER=local
MEDIA_CDN_BASE_URL=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI features (optional -- a template-based fallback is used if unset)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=20

# Feature flags (all optional, default to disabled/off if unset)
ENABLE_BOOKS_WEB3=false
BOOKS_MARKETPLACE_ENABLED=false
CREATOR_PORTAL_ENABLED=false
DIGITAL_LIBRARY_ENABLED=false

# Public URLs (Production Only)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_MEDIA_URL=https://api.yourdomain.com/media
NEXT_PUBLIC_BASE_PATH=/admin
VITE_API_URL=https://api.yourdomain.com/api/v1
VITE_MEDIA_URL=https://api.yourdomain.com/media

# Live Chat (Tawk.to) -- shared Site ID, one widget ID per app. Without
# these, admin-dashboard/web-store build with chat silently disabled
# (DriftChat.tsx already no-ops gracefully when unset, but you likely want
# it configured for real support coverage).
NEXT_PUBLIC_TAWK_SITE_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=1jm6uk6rp
VITE_TAWK_SITE_ID=
VITE_TAWK_WIDGET_ID=1jm6uk6rp

# PGAdmin
PGADMIN_EMAIL=admin@techtools.com
PGADMIN_PASSWORD=Admin123!
