# TechTools Mobile App - local development environment
#
# Copy this file to .env.local (gitignored, never commit real values) to
# override the API URL used by `npm start` / `expo start`. Expo automatically
# loads .env.local for local dev; EAS builds (development/staging/preview/
# production) instead get these values from the matching profile's `env`
# block in eas.json -- see src/config/env.ts for the resolution logic.
#
# If unset, local dev falls back to http://localhost:9000/api/v1 (the
# tech-tools-api default dev port). Set this to your machine's LAN IP
# (e.g. http://192.168.1.42:9000/api/v1) when testing on a physical device
# so it can actually reach your dev machine -- localhost on a device means
# the device itself, not your computer.
EXPO_PUBLIC_API_URL=http://localhost:9000/api/v1

# development | staging | production -- controls whether a missing
# EXPO_PUBLIC_API_URL is allowed to fall back to localhost (development) or
# fails loudly instead (staging/production). Leave as "development" locally.
EXPO_PUBLIC_APP_ENV=development
