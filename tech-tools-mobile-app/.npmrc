# amazon-ivs-react-native-player@1.6.1 ships a broken `postinstall: husky`
# script (husky isn't a dependency anywhere in this tree, so the binary
# doesn't exist -- a packaging bug in that library, not something we did).
# It's a real `postinstall`, not `prepare` (which npm only runs for the
# root project/git deps, not nested registry deps), so it runs -- and
# aborts the whole install -- on every `npm ci`/`npm install`, in CI and
# on EAS Build alike.
#
# Disabling lifecycle scripts repo-wide is safe here: it was verified
# that the only OTHER real `postinstall` in this entire dependency tree
# (unrs-resolver, used by eslint-import-resolver-typescript) still loads
# and works correctly without it -- npm's own optionalDependencies
# platform filtering already places the right prebuilt native binary on
# disk regardless of this flag.
ignore-scripts=true
