{
  "name": "techtools",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start --android",
    "ios": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start --ios",
    "web": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start --web",
    "lint": "expo lint",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "build:local": "eas build --profile preview --platform android --local",
    "submit:android": "eas submit --platform android",
    "update": "eas update --branch production",
    "credentials": "eas credentials"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.28",
    "@expo/vector-icons": "^15.0.2",
    "axios": "^1.7.0",
    "zustand": "^5.0.0",
    "expo": "~55.0.4",
    "expo-constants": "~55.0.7",
    "expo-device": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.7",
    "expo-image": "~55.0.5",
    "expo-linear-gradient": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.3",
    "expo-secure-store": "~55.0.8",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-web-browser": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-worklets": "0.7.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
