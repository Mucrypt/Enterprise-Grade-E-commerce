{
  "name": "techtools",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start --android",
    "ios": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start --ios",
    "web": "NODE_OPTIONS='--dns-result-order=ipv4first' expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:local": "eas build --profile preview --platform android --local",
    "build:submit": "eas build --profile production --platform android --auto-submit",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "update:preview": "eas update --branch preview",
    "update:prod": "eas update --branch production",
    "credentials": "eas credentials",
    "release": "bash ./scripts/release.sh",
    "deploy": "bash ./scripts/deploy.sh",
    "test:ci": "bash ./scripts/test-ci.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.28",
    "@stripe/stripe-react-native": "0.63.0",
    "axios": "^1.7.0",
    "expo": "~55.0.23",
    "expo-av": "^16.0.8",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.32",
    "expo-device": "~55.0.16",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.10",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.15",
    "expo-notifications": "~55.0.22",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.17",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
