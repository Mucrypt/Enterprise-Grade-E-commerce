{
  "expo": {
    "name": "TechTools",
    "slug": "techtools",
    "version": "1.13.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "techtools",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mucrypt.techtools",
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "buildNumber": "13"
    },
    "android": {
      "package": "com.mucrypt.techtools",
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.mucrypt.techtools"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.mucrypt.techtools",
          "enableGooglePay": true,
          "urlScheme": "techtools",
          "enableApplePay": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B35",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ca65323f-0ec5-44b1-8fcd-c634f36efb70"
      },
      "router": {}
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/ca65323f-0ec5-44b1-8fcd-c634f36efb70",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "yongsi"
  }
}
