FROM node:20-alpine

WORKDIR /app

# Install dependencies for development. ffmpeg is real -- processDiscoverVideo
# (utils/media.ts) shells out to it to transcode uploads to H.264/AAC MP4.
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    ffmpeg

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies). --no-audit
# skips npm's post-install registry audit call -- confirmed unreliable
# in this Docker network environment (see admin-dashboard/Dockerfile.dev),
# and not needed for a container build anyway.
RUN npm install --no-audit --no-fund

# Copy source code
COPY . .

# Expose port
EXPOSE 9000

# Run in development mode with hot reload
CMD ["npm", "run", "dev"]
