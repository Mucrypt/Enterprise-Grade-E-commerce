FROM node:20-alpine

WORKDIR /app

# Install dependencies for development. ffmpeg is real -- processDiscoverVideo
# (utils/media.ts) shells out to it to transcode uploads to H.264/AAC MP4.
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    ffmpeg

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 9000

# Run in development mode with hot reload
CMD ["npm", "run", "dev"]
