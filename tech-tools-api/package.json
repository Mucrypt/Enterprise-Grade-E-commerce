{
  "name": "techtools-api",
  "version": "1.0.0",
  "description": "TechTools Global E-commerce API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "migrate:up": "ts-node src/database/migrate.ts up",
    "migrate:down": "ts-node src/database/migrate.ts down",
    "migrate:status": "ts-node src/database/migrate.ts status",
    "migrate:admin": "./infra/scripts/migrate-admin-schema.sh",
    "seed": "ts-node src/database/seeds/run-seeds.ts",
    "seed:brands": "ts-node src/database/seeds/004_seed_brands.ts",
    "seed:categories": "ts-node src/database/seeds/002_seed_categories.ts",
    "seed:products": "ts-node src/database/seeds/003_seed_products.ts",
    "seed:collections": "ts-node src/database/seeds/005_seed_collections.ts",
    "seed:superadmin": "ts-node src/database/seeds/create-super-admin.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "docker:dev": "docker compose -f ../infrastructure/docker-compose.dev.yml up api -d --build",
    "docker:dev:logs": "docker compose -f ../infrastructure/docker-compose.dev.yml logs -f api",
    "docker:dev:stop": "docker compose -f ../infrastructure/docker-compose.dev.yml stop api",
    "docker:dev:restart": "npm run docker:dev:stop && npm run docker:dev",
    "docker:prod": "docker compose -f ../infrastructure/docker-compose.prod.yml up api -d --build",
    "docker:prod:logs": "docker compose -f ../infrastructure/docker-compose.prod.yml logs -f api",
    "docker:exec": "docker exec -it techtools-api-dev sh",
    "docker:backup": "./infra/scripts/backup-db.sh",
    "ssl:setup": "./infra/scripts/ssl-setup.sh",
    "generate:types": "docker exec techtools-api-dev npm run generate:types:local",
    "generate:types:local": "ts-node scripts/generate-types-from-db.ts",
    "types:watch": "nodemon --watch src/database/migrations --exec npm run generate:types"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.350.0",
    "@types/mime-types": "^3.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "mime-types": "^3.0.2",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^8.0.2",
    "pg": "^8.11.0",
    "redis": "^4.6.7",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stripe": "^17.7.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.2",
    "uuid": "^9.0.1",
    "winston": "^3.9.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.33",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.11",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
