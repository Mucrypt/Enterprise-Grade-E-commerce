{
  "info": {
    "name": "TechTools API - Complete Enterprise v3",
    "description": "Complete API collection with Admin Management, Media Upload, and Collections features.\n\n**Features:**\n- ✅ Admin Management (Super Admin only)\n- ✅ Product & Category CRUD with Media Upload\n- ✅ Media Management (Images & Videos)\n- ✅ Collections (Product & Category grouping)\n- ✅ Auto token management\n- ✅ Response tests\n\n**Quick Start:**\n1. Run 'Auth > Login Super Admin' to authenticate\n2. Token is auto-saved and used in all requests\n3. Test all endpoints with pre-configured data\n\n**Super Admin:** romeomukulah@gmail.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "mediaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "collectionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "superAdminEmail",
      "value": "romeomukulah@gmail.com",
      "type": "string"
    },
    {
      "key": "superAdminId",
      "value": "c429e249-c897-496a-8da8-12bc5209f609",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has access token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('accessToken');",
                  "    pm.expect(jsonData.data.user.userType).to.eql('super_admin');",
                  "});",
                  "",
                  "// Save token for future requests",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('superAdminId', jsonData.data.user.id);",
                  "    console.log('✅ Token saved:', jsonData.data.accessToken.substring(0, 20) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"YourSecurePassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login as super admin to get access token. Token is auto-saved for all subsequent requests."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('User is super_admin', () => {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.user.userType).to.eql('super_admin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Get currently authenticated user details"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints - login and get current user"
    },
