# Production Environment Variables
# IMPORTANT: Update all values before deploying to production!

# Node Environment
NODE_ENV=production
PORT=9000

# Domain Configuration
DOMAIN=api.yourdomain.com

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=techtools_prod
DB_USER=techtools_user
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD_123!

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_456!

# JWT Secrets (MUST CHANGE THESE!)
JWT_SECRET=CHANGE_THIS_TO_VERY_LONG_RANDOM_STRING_789
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_STRING_012
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Configuration (your frontend URLs)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# Email Configuration (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-hostinger-mail-password
SMTP_FROM=noreply@yourdomain.com
EMAIL_FROM=Your Store <noreply@yourdomain.com>
EMAIL_FROM_NAME=Your Store
ADMIN_NOTIFICATION_EMAILS=admin@yourdomain.com,orders@yourdomain.com
ADMIN_DASHBOARD_URL=https://techtoolstore.com/admin/dashboard

# Media Storage (choose one provider)
MEDIA_STORAGE_PROVIDER=local
MEDIA_CDN_BASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy AWS S3 Configuration (unused unless you add a custom S3 provider)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1
S3_BUCKET_NAME=techtools-uploads

# Payment Gateways
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET_KEY=your_paypal_secret_key

# PgAdmin (optional for production)
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=SecureAdminPassword123!

# Monitoring & Logging
LOG_LEVEL=info
