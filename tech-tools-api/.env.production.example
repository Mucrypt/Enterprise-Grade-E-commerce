# Production Environment Variables
# IMPORTANT: Update all values before deploying to production!

# Node Environment
NODE_ENV=production
PORT=9000

# Domain Configuration
DOMAIN=api.yourdomain.com

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=techtools_prod
DB_USER=techtools_user
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD_123!

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_456!

# JWT Secrets (MUST CHANGE THESE!)
JWT_SECRET=CHANGE_THIS_TO_VERY_LONG_RANDOM_STRING_789
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_STRING_012
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Configuration (your frontend URLs)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# Email Configuration (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-hostinger-mail-password
SMTP_FROM=noreply@yourdomain.com
EMAIL_FROM=Your Store <noreply@yourdomain.com>
EMAIL_FROM_NAME=Your Store
ADMIN_NOTIFICATION_EMAILS=admin@yourdomain.com,orders@yourdomain.com
ADMIN_DASHBOARD_URL=https://techtoolstore.com/admin/dashboard

# Media Storage (choose one provider)
MEDIA_STORAGE_PROVIDER=local
MEDIA_CDN_BASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy AWS S3 Configuration (unused unless you add a custom S3 provider)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1
S3_BUCKET_NAME=techtools-uploads

# Payment Gateways
# STRIPE_PUBLISHABLE_KEY and STRIPE_WEBHOOK_SECRET were missing from this
# file entirely (only the dev .env.example had them). Without
# STRIPE_WEBHOOK_SECRET, the /payments/webhook endpoint returns 500
# "Webhook not configured" for every event Stripe sends -- payment
# confirmation, refunds, and the checkout-session flow all depend on it.
# Get the webhook secret from the Stripe Dashboard -> Developers -> Webhooks
# -> your production endpoint (https://yourdomain.com/api/v1/payments/webhook).
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET_KEY=your_paypal_secret_key

# PgAdmin (optional for production)
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=SecureAdminPassword123!

# Monitoring & Logging
LOG_LEVEL=info

# =====================================================
# Public URLs
# Used to build links inside emails/notifications (password reset,
# order confirmations, admin alert links, etc). ADMIN_DASHBOARD_URL was
# already required elsewhere in this file; these are the others actually
# read by the codebase.
# =====================================================
FRONTEND_URL=https://yourdomain.com
WEB_STORE_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com/api/v1
MOBILE_APP_URL=https://yourdomain.com

# =====================================================
# Feature Flags (all optional -- default to disabled/off if unset)
# =====================================================
ENABLE_SELLER_TIERS=false
ENABLE_BOOKS_WEB3=false
ENABLE_ADMIN_BOOK_PUBLISHING=false
ENABLE_BUSINESS_MODE_SWITCH=false
DIGITAL_LIBRARY_ENABLED=false

# =====================================================
# WhatsApp Notifications (optional -- order confirmations/alerts degrade
# gracefully without these, already wrapped in try/catch)
# =====================================================
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_FROM_NUMBER=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
SMS_CRITICAL_ONLY=false

# =====================================================
# Slack Notifications (optional)
# =====================================================
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_API_URL=

# =====================================================
# AI Features (optional -- template fallback is used if unset)
# =====================================================
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=20
AI_GUARDRAIL_MIN_SCORE=0.7
AI_ENABLE_TEMPLATE_FALLBACK=true

# =====================================================
# Newsletter Sending (optional tuning, sensible defaults exist in code)
# =====================================================
NEWSLETTER_MAX_RETRIES=3
NEWSLETTER_QUEUE_INTERVAL_MS=60000
NEWSLETTER_RATE_LIMIT_PER_MINUTE=30
NEWSLETTER_RETRY_BACKOFF_SECONDS=300
NEWSLETTER_TRACKING_BASE_URL=https://api.yourdomain.com/api/v1

# =====================================================
# Contact / notification email routing (optional -- falls back to
# ADMIN_NOTIFICATION_EMAILS above if unset)
# =====================================================
ADMIN_EMAIL=admin@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
INTERNAL_NOTIFICATION_EMAILS=

# =====================================================
# Product economics / auto-pause tuning (optional, sensible defaults
# exist in code -- see suppliers/product-economics.service.ts)
# =====================================================
AUTO_PAUSE_MARGIN_FLOOR_PERCENT=5
DEFAULT_AD_COST_PER_ORDER=0
DEFAULT_EXPECTED_REFUND_COST=0
DEFAULT_PAYMENT_FEE_PER_ORDER=0
PRODUCT_ECONOMICS_INTERVAL_MS=3600000
AB_AUTO_WINNER_MIN_DELTA=0.05
AB_AUTO_WINNER_MIN_SAMPLE=100
