# Development Environment Variables

# Node Environment
NODE_ENV=development
PORT=9000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techtools
DB_USER=techtools_user
DB_PASSWORD=ChangeMe123!

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API Configuration
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Media Upload Configuration
MEDIA_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
CDN_DOMAIN=http://localhost:9000
MEDIA_CDN_BASE_URL=

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (Hostinger example)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@techtoolstore.com
SMTP_PASS=your-hostinger-mail-password
SMTP_FROM=noreply@techtoolstore.com
EMAIL_FROM=TechTools Store <noreply@techtoolstore.com>
EMAIL_FROM_NAME=TechTools Store
ADMIN_NOTIFICATION_EMAILS=admin@techtoolstore.com
ADMIN_DASHBOARD_URL=https://techtoolstore.com/admin/dashboard

# AWS S3 (optional for development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Payment Gateways (use test/sandbox keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=

# PgAdmin Configuration
PGADMIN_EMAIL=admin@techtools.com
PGADMIN_PASSWORD=Admin123!

# Shipping carriers (FedEx/UPS/DHL). Without real credentials above and no
# ALLOW_MOCK_SHIPPING, carrier rate/label/tracking calls now fail loudly
# instead of silently returning fabricated data. Set to "true" to allow
# mock shipping responses for local development when you don't have real
# sandbox carrier credentials. Ignored entirely when NODE_ENV=production --
# mock shipping can never run in production regardless of this value.
ALLOW_MOCK_SHIPPING=true

# Promotions / Social Publishing (PROMOTION-OPS-1). Real 32-byte base64
# AES-256-GCM key -- generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required before any social OAuth connection can be stored (production
# refuses to start encrypting/decrypting tokens without it). Never commit
# a real value here or anywhere else -- leave this line empty in every
# checked-in copy of this file.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Comma-separated list of allowed OAuth redirect origins for the
# Promotions "Connections" flow -- checked as an exact origin (scheme +
# host + port) match, not a path. Fail-closed: if this is empty, no social
# OAuth flow can start at all -- never treated as "allow anything." The
# admin dashboard is served at the same origin as the storefront via an
# nginx path prefix (see infrastructure/nginx/prod.conf's `location
# /admin`), not a separate subdomain, so the production value is the bare
# storefront origin:
#   SOCIAL_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://techtoolstore.com,http://localhost:3000
SOCIAL_OAUTH_ALLOWED_REDIRECT_ORIGINS=

# Safe-by-default: every campaign publishes in simulation only until this
# is explicitly set to the literal string "false". Nothing can reach a
# real social API by accident.
SOCIAL_PUBLISH_DRY_RUN=true

# Per-platform readiness -- each defaults to disabled/unconfigured. Set
# _ENABLED=true and both _CLIENT_ID/_CLIENT_SECRET (from that platform's
# own developer console) only once you intend to actually connect it; see
# docs/SOCIAL-PUBLISHING-ARCHITECTURE.md for what each platform additionally
# requires (app review, etc.) before publishing can genuinely succeed.
SOCIAL_FACEBOOK_ENABLED=false
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_INSTAGRAM_ENABLED=false
SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_SECRET=
SOCIAL_TIKTOK_ENABLED=false
SOCIAL_TIKTOK_CLIENT_ID=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_LINKEDIN_ENABLED=false
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_PINTEREST_ENABLED=false
SOCIAL_PINTEREST_CLIENT_ID=
SOCIAL_PINTEREST_CLIENT_SECRET=
SOCIAL_X_ENABLED=false
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=

# Promotion publish queue -- explicit single-worker-instance safety valve.
# Defaults to enabled; the current verified production topology
# (infrastructure/docker-compose.prod.yml) runs exactly one API
# container. If that ever changes to multiple replicas, set this to
# "false" on every instance except the one deliberately designated to
# publish -- see promotion-campaign.queue.ts's header comment.
PROMOTION_QUEUE_ENABLED=true

# Seconds a channel post may sit in PUBLISHING with no confirmed
# remote_post_id before the queue sweeps it to REQUIRES_ACTION for human
# review (never blindly requeued -- the outcome of the crashed/interrupted
# attempt is genuinely unknown). Default 300 (5 minutes).
PROMOTION_STUCK_TIMEOUT_SECONDS=300