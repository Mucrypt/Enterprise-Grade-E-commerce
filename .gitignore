# Root ignores (monorepo)

# Dependencies
**/node_modules/

# Build output
**/dist/
**/build/
**/.next/
**/out/

# Logs
**/logs/
**/*.log

# Local env (never commit)
.env
.env.*

# OS / IDE
.DS_Store
.idea/
.vscode/

# Temporary
**/.cache/
**/tmp/
**/temp/

# Uploaded/media artifacts
tech-tools-api/uploads/

# Backups
**/backups/

# TLS / certbot artifacts
**/letsencrypt/
**/*.pem
**/*.key
**/*.crt

# SSH deploy keys (see .github/DEPLOY-SETUP.md) -- generated directly in the
# repo working directory by the setup steps there; must never be committed.
techtools-deploy-key
techtools-deploy-key.pub
